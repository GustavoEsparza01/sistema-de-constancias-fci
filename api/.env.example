# URL del proyecto de Supabase (Project Settings > API > Project URL)
SUPABASE_URL=

# Llave service_role de Supabase (Project Settings > API > service_role).
# SECRETA: solo vive aquí, en el servidor. Nunca en el frontend ni en Git.
SUPABASE_SERVICE_ROLE_KEY=

# Origen exacto del frontend, para CORS. Sin barra final.
# En local: http://localhost:5173
FRONTEND_URL=

# Puerto de escucha. Render lo inyecta automáticamente; en local usa 3000.
PORT=3000
