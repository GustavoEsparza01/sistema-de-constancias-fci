# URL base de la API (servicio de Render). Sin barra final.
# En local: http://localhost:3000
VITE_API_URL=

# Validar el login contra la API ("true"). Con cualquier otro valor la
# pantalla de login se muestra pero acepta cualquier correo y contraseña.
# Apagado mientras no esté configurado Supabase; al activarlo también hace
# falta VITE_API_URL.
VITE_AUTH_ENABLED=false
